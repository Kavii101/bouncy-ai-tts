# Copy to .env on the VPS (chmod 600). Never commit the real file.
APP_PORT=3020
# Always a pinned tag; `latest` makes a rollback ambiguous.
IMAGE=ghcr.io/kavii101/interview-copilot:<full-git-sha>
JWT_SECRET=change-me-random
BUILT_IN_FORGE_API_URL=https://api.openai.com
BUILT_IN_FORGE_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-transcribe
INTERVIEW_COPILOT_ENABLED=true
INTERVIEW_LIVE_ASSIST_ENABLED=true
