# Copy to .env and fill in. Never commit .env.
# SQLite file path. Create the tables with: DATABASE_URL=./local.db pnpm drizzle-kit push
DATABASE_URL=./local.db

# Option B (self-hosted, OpenAI). For Manus Forge, use your Forge URL + key instead.
BUILT_IN_FORGE_API_URL=https://api.openai.com
BUILT_IN_FORGE_API_KEY=sk-...
# LLM_MODEL=gpt-4.1-mini          # optional; default on api.openai.com
# TRANSCRIPTION_MODEL=whisper-1   # optional

INTERVIEW_COPILOT_ENABLED=true
INTERVIEW_LIVE_ASSIST_ENABLED=true
JWT_SECRET=change-me
# PORT=3000
# OAuth vars are not needed: without them the app runs in no-login mode.
